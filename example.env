# Copy this file to .env and fill in your real values
# .env is gitignored — NEVER commit the real .env

# Gemini API Keys (get free keys at https://aistudio.google.com/apikey)
# Add as many keys as you want for rotation on quota exhaustion
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# DeepSeek API Key (optional fallback — https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# App config
APP_ENV=development
